#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Uso:
  lume-shell [run] [argumentos do Quickshell]  Inicia a shell
  lume-shell lock                             Bloqueia a sessão com o lockscreen do Lume
  lume-shell greeter install [--restart]      Instala a integração opcional do ReGreet
  lume-shell spotlight <comando>              Controla o Spotlight em execução

Comandos do Spotlight:
  open | toggle | clipboard | actions | theme | config
  emoji | kill | windows | search <texto>

Exemplos:
  lume-shell spotlight clipboard
  lume-shell spotlight search "Firefox"

LUME_SHELL_CONFIG pode apontar para outro diretório de configuração.
EOF
}

config_path=${LUME_SHELL_CONFIG:-${QS_CONFIG_PATH:-/usr/share/lume-shell}}

if [ "$#" -eq 0 ]; then
  exec /usr/bin/quickshell --path "$config_path"
fi

case "$1" in
  -h|--help|help)
    usage
    exit 0
    ;;
  run)
    shift
    exec /usr/bin/quickshell --path "$config_path" "$@"
    ;;
  lock)
    shift
    if [ "$#" -ne 0 ]; then
      printf 'lume-shell lock não aceita argumentos.\n' >&2
      exit 2
    fi

    lockscreen_path=${LUME_SHELL_LOCKSCREEN_PATH:-}
    if [ -z "$lockscreen_path" ]; then
      if [ -r "$config_path/lockscreen.qml" ]; then
        lockscreen_path="$config_path/lockscreen.qml"
      else
        lockscreen_path=/usr/share/lume-shell/lockscreen.qml
      fi
    fi
    if [ ! -r "$lockscreen_path" ]; then
      printf 'lume-shell: lockscreen não encontrado: %s\n' "$lockscreen_path" >&2
      exit 1
    fi
    if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "$XDG_RUNTIME_DIR" ]; then
      printf 'lume-shell: XDG_RUNTIME_DIR não está disponível.\n' >&2
      exit 1
    fi

    if /usr/bin/flock -n -E 75 "$XDG_RUNTIME_DIR/lumeshell-lock.lock" \
      /usr/bin/quickshell --path "$lockscreen_path"; then
      exit 0
    else
      status=$?
      # A second request while this lockscreen is active is an intentional no-op.
      [ "$status" -eq 75 ] && exit 0
      exit "$status"
    fi
    ;;
  greeter)
    shift
    if [ "${1:-}" != "install" ]; then
      printf 'Uso: lume-shell greeter install [--restart]\n' >&2
      exit 2
    fi
    exec /usr/lib/lume-shell/setup-regreet.sh "$@"
    ;;
  spotlight)
    shift
    ;;
  *)
    printf 'lume-shell: comando desconhecido: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac

if [ "$#" -eq 0 ]; then
  printf 'lume-shell: informe um comando do Spotlight.\n' >&2
  usage >&2
  exit 2
fi

command=$1
shift
case "$command" in
  open|toggle|clipboard|actions|theme|config|emoji|kill|windows)
    if [ "$#" -ne 0 ]; then
      printf 'lume-shell: "%s" não aceita argumentos.\n' "$command" >&2
      exit 2
    fi
    set -- "$command"
    ;;
  search)
    if [ "$#" -eq 0 ]; then
      printf 'lume-shell: informe o texto para pesquisar.\n' >&2
      exit 2
    fi
    query=$*
    set -- search "$query"
    ;;
  *)
    printf 'lume-shell: comando de Spotlight desconhecido: %s\n' "$command" >&2
    usage >&2
    exit 2
    ;;
esac

exec /usr/bin/quickshell ipc --path "$config_path" call spotlight "$@"
