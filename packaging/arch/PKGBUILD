# Maintainer: Emanuel Serpa
pkgname=lume-shell
# Local source-build fallback; release workflow supplies the Git tag version.
pkgver="${_release_pkgver:-0.1.5}"
pkgrel=26
pkgdesc='Wayland desktop shell built with Quickshell'
arch=('x86_64')
url='https://github.com/emanuelserpa/lume-shell'
license=('MIT')
depends=('quickshell' 'qt6-5compat' 'qt6-declarative' 'glib2' 'python' 'python-requests'
  'python-pillow' 'systemd' 'polkit' 'power-profiles-daemon' 'util-linux' 'fontconfig' 'kitty')
optdepends=(
  'noto-fonts: default interface font family'
  'ttf-nerd-fonts-symbols-mono: additional interface icons'
  'wl-clipboard: clipboard history'
  'brightnessctl: brightness controls'
  'upower: battery state'
  'networkmanager: network controls'
  'network-manager-applet: advanced network connection editor'
  'bluez: Bluetooth controls'
  'pipewire: audio controls'
  'wireplumber: audio device management'
  'xdg-utils: opening URLs and applications'
  'fd: Spotlight file search'
  'grim: screenshots'
  'slurp: region screenshots'
  'wayland-utils: compositor protocol diagnostics'
  'hyprland: Hyprland compositor integration'
  'labwc: labwc compositor integration'
  'mangowm: Mango focused-output and workspace compatibility state'
  'pacman-contrib: repository update indicator'
  'fprintd: fingerprint authentication in the native lockscreen prototype'
  'greetd-regreet: optional ReGreet login screen integration'
  'cage: Wayland compositor for the ReGreet login screen'
)
makedepends=('git' 'tar')
backup=('etc/pam.d/lumeshell-lock' 'etc/pam.d/lumeshell-lock-password')
install=lume-shell.install
options=('!strip')

_commit="${_release_commit:-}"
_local_source="${_local_source:-}"
if [[ -z "$_local_source" && -z "$_commit" ]]; then
  _local_source="$(cd "$startdir/../.." && pwd)"
fi
if [[ -n "$_local_source" ]]; then
  source=()
  sha256sums=()
else
  source=("lume-shell::git+https://github.com/emanuelserpa/lume-shell.git#commit=${_commit}")
  sha256sums=('SKIP')
fi

prepare() {
  if [[ -n "$_local_source" ]]; then
    [[ -d "$_local_source" ]] || { error "Local source not found: $_local_source"; return 1; }
    mkdir -p "$srcdir/lume-shell"
    tar -C "$_local_source" \
      --exclude='./.git' --exclude='./.pytest_cache' --exclude='./.cache' \
      --exclude='__pycache__' \
      --exclude='./packaging/arch/src' --exclude='./packaging/arch/pkg' \
      --exclude='*.pkg.tar.*' --exclude='*.src.tar.*' --exclude='*.bundle' \
      --exclude='./power/cpu-boost.json' --exclude='./state' \
      -cf - . | tar -C "$srcdir/lume-shell" -xf -
  fi
}

package() {
  local root="$srcdir/lume-shell"
  local share="$pkgdir/usr/share/lume-shell"
  install -d "$share" "$pkgdir/usr/bin" \
    "$pkgdir/usr/lib/systemd/user" "$pkgdir/usr/lib/systemd/system" \
    "$pkgdir/usr/lib/lumeshell" "$pkgdir/usr/share/polkit-1/rules.d" \
    "$pkgdir/usr/share/doc/lume-shell"
  install -Dm644 "$root/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  for entry in shell.qml Theme.qml qmldir assets bar components controlcenter \
    data launcher lockscreen notifications osd references scripts services; do
    cp -R --no-preserve=ownership "$root/$entry" "$share/"
  done
  install -Dm644 "$root/lockscreen.qml" "$share/lockscreen.qml"
  install -Dm644 "$root/lockscreen-preview.qml" "$share/lockscreen-preview.qml"
  install -Dm755 "$startdir/lume-shell" "$pkgdir/usr/bin/lume-shell"
  install -Dm755 "$startdir/setup-regreet.sh" \
    "$pkgdir/usr/lib/lume-shell/setup-regreet.sh"
  install -Dm644 "$root/packaging/arch/greetd/config.toml" \
    "$share/greetd/config.toml"
  install -Dm644 "$root/packaging/arch/greetd/regreet.toml" \
    "$share/greetd/regreet.toml"
  install -Dm644 "$root/packaging/arch/greetd/regreet.css" \
    "$share/greetd/regreet.css"
  install -Dm644 "$startdir/lume-shell.service" \
    "$pkgdir/usr/lib/systemd/user/lume-shell.service"
  install -Dm755 "$root/system/cpu-boost-privileged" \
    "$pkgdir/usr/lib/lumeshell/lumeshell-cpu-boost"
  install -Dm755 "$root/system/power-profile-privileged" \
    "$pkgdir/usr/lib/lumeshell/lumeshell-power-profile"
  install -Dm755 "$root/system/battery-charge-limit-privileged" \
    "$pkgdir/usr/lib/lumeshell/lumeshell-battery-charge-limit"
  install -Dm644 "$root/system/systemd/lumeshell-power-source-policy.service" \
    "$pkgdir/usr/lib/systemd/system/lumeshell-power-source-policy.service"
  install -Dm644 "$root/system/systemd/user/lumeshell-cpu-boost-restore.service" \
    "$pkgdir/usr/lib/systemd/user/lumeshell-cpu-boost-restore.service"
  install -Dm644 "$root/system/polkit/50-lumeshell-cpu-boost.rules" \
    "$pkgdir/usr/share/polkit-1/rules.d/50-lumeshell-cpu-boost.rules"
  install -Dm644 "$root/system/polkit/50-lumeshell-power-profile.rules" \
    "$pkgdir/usr/share/polkit-1/rules.d/50-lumeshell-power-profile.rules"
  install -Dm644 "$root/system/polkit/50-lumeshell-battery-charge-limit.rules" \
    "$pkgdir/usr/share/polkit-1/rules.d/50-lumeshell-battery-charge-limit.rules"
  install -Dm644 "$root/packaging/pam/lumeshell-lock" \
    "$pkgdir/etc/pam.d/lumeshell-lock"
  install -Dm644 "$root/packaging/pam/lumeshell-lock-password" \
    "$pkgdir/etc/pam.d/lumeshell-lock-password"
  install -Dm644 "$root/README.md" "$pkgdir/usr/share/doc/lume-shell/README.md"
  for doc in arch-packaging-plan dependency-inventory compositor-integration \
    lockscreen-prototype wayland-install wayland-compositor-research greetd-regreet; do
    if [[ -f "$root/docs/$doc.md" ]]; then
      install -Dm644 "$root/docs/$doc.md" \
        "$pkgdir/usr/share/doc/lume-shell/$doc.md"
    fi
  done
  install -Dm644 "$root/workspaces.json.example" \
    "$pkgdir/usr/share/doc/lume-shell/workspaces.json.example"
}
