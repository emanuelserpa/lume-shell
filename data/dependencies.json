{
  "schema_version": 1,
  "project": "Lume",
  "arch_package": "lume-shell",
  "support_target": {
    "distribution": "Arch Linux",
    "architecture": "x86_64",
    "session": "Wayland",
    "init": "systemd"
  },
  "requirements": [
    {
      "command": "quickshell",
      "level": "required",
      "purpose": "executar a interface",
      "arch_package": "quickshell",
      "arch_source": "official repositories"
    },
    {
      "command": "python3",
      "level": "required",
      "purpose": "helpers do shell",
      "arch_package": "python",
      "arch_source": "official repositories"
    },
    {
      "command": "systemctl",
      "level": "required",
      "purpose": "serviço de usuário",
      "arch_package": "systemd",
      "arch_source": "official repositories"
    },
    {
      "command": "kitty",
      "level": "required",
